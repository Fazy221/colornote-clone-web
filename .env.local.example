# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored — it will never get committed or pushed to GitHub.
#
# Where to find these values:
#   1. https://console.firebase.google.com → your project
#   2. Click the gear icon (top left) → Project settings
#   3. Scroll to "Your apps" → the web app (</> icon) you registered
#   4. Under "SDK setup and configuration", select "Config"
#   5. Copy each value below from that object

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
