# Firebase CLI cache/logs — regenerated on every deploy, machine-specific
.firebase/
firebase-debug.log

# Dependencies
node_modules/

# Build output
dist/
android/app/build/
android/.gradle/

# Env files — Firebase config, and later B2 keys, live here. Never commit.
.env
.env.local
.env.*.local

# Editor/OS cruft
.DS_Store
*.log
.vscode/

# MCP server: never commit a service-account key
mcp-server/*.json.key
service-account*.json
*-adminsdk-*.json
colornote-reader*.json
!mcp-server/package.json
!mcp-server/package-lock.json
